# =============================================================================
# APPLICATION ENVIRONMENT TEMPLATE
# =============================================================================
# Copy to `.env` for local development. Never commit real credentials.

APP__ENV=dev

# HTTP Server
APP__SERVER__HOST=127.0.0.1
APP__SERVER__PORT=3000
APP__SERVER__DOMAIN=http://localhost:3000
SVELTE_SITE_ROOT=svelte-app/build
PUBLIC_ASSETS_ROOT=public

# PostgreSQL Database
APP__DATABASE__URL=postgres://postgres:postgres@127.0.0.1:5432/axum_svelte_todo
APP__DATABASE__MAX_CONNECTIONS=20

# Structured Logging
APP__LOGGING__LEVEL=info,server=debug,services=debug,api=debug
APP__LOGGING__FORMAT=pretty

# Cryptographic / Token Secret (min 32 chars in staging/prod)
APP__JWT__SECRET=dev-only-change-me-at-least-32-characters-long

# Seeded Default Admin Identity (Google OAuth login matches email)
APP__ADMIN__EMAIL=admin@example.com
APP__ADMIN__NAME=Template Admin

# Google OAuth 2.0 (leave placeholder in dev if using Test Accounts or /api/test/sql)
APP__GOOGLE__CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APP__GOOGLE__CLIENT_SECRET=your-google-client-secret
APP__GOOGLE__REDIRECT_URI=http://localhost:3000/auth/google/callback

# Moka In-Memory Cache Tuning
APP__CACHE__SESSION_TTL_SECS=300
APP__CACHE__USER_TTL_SECS=300
APP__CACHE__MAX_CAPACITY=10000

# Optional Cloudflare R2 / S3 Compatible Storage
# Leave empty to run cleanly without object storage; attachments will return
# `ErrorCode::StorageNotConfigured` until credentials are configured.
APP__R2__ACCOUNT_ID=
APP__R2__ACCESS_KEY_ID=
APP__R2__SECRET_ACCESS_KEY=
APP__R2__BUCKET_NAME=
APP__R2__PUBLIC_URL=
